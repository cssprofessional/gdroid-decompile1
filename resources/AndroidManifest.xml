<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="43"
    android:versionName="0.1.29"
    android:compileSdkVersion="35"
    android:compileSdkVersionCodename="15"
    package="com.gmodvr.flat"
    platformBuildVersionCode="35"
    platformBuildVersionName="15">
    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="35"/>
    <uses-feature
        android:glEsVersion="0x30000"
        android:required="true"/>
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <application
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:name="com.gmodvr.flat.FlatApplication"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:fullBackupContent="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <meta-data
            android:name="com.gmodvr.UPDATE_ABI"
            android:value="arm64-v8a"/>
        <activity
            android:name="com.gmodvr.flat.LauncherActivity"
            android:exported="true"
            android:configChanges="density|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/GameTheme"
            android:name="com.gmodvr.flat.GameActivity"
            android:exported="false"
            android:process=":game"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="density|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard"
            android:hardwareAccelerated="true"
            android:enableOnBackInvokedCallback="false"/>
        <activity
            android:name="com.gmodvr.flat.SteamDownloadActivity"
            android:exported="false"
            android:configChanges="density|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard"/>
        <activity
            android:name="com.gmodvr.flat.WorkshopQueueActivity"
            android:exported="false"
            android:configChanges="density|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard"/>
        <activity
            android:name="com.gmodvr.flat.ModManagerActivity"
            android:exported="false"
            android:configChanges="density|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard"/>
        <activity
            android:name="com.gmodvr.flat.CustomButtonsActivity"
            android:exported="false"
            android:configChanges="density|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard"/>
        <activity
            android:name="com.gmodvr.flat.TouchLayoutActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="density|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard"
            android:enableOnBackInvokedCallback="false"/>
        <service
            android:name="com.gmodvr.flat.ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <activity
            android:name="com.gmodvr.flat.UpdateSettingsActivity"
            android:exported="false"
            android:configChanges="density|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard"/>
        <service
            android:name="com.gmodvr.flat.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <receiver
            android:name="com.gmodvr.flat.UpdateInstallReceiver"
            android:exported="false"/>
        <service
            android:name="com.gmodvr.flat.SteamDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <provider
            android:name="com.gmodvr.flat.SteamIdentityProvider"
            android:exported="false"
            android:authorities="com.gmodvr.flat.steam_identity"
            android:grantUriPermissions="false"/>
        <provider
            android:name="com.gmodvr.flat.DiagnosticsProvider"
            android:exported="false"
            android:authorities="com.gmodvr.flat.diagnostics"
            android:grantUriPermissions="true"/>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:exported="false"
            android:authorities="com.gmodvr.flat.androidx-startup">
            <meta-data
                android:name="okhttp3.internal.platform.PlatformInitializer"
                android:value="androidx.startup"/>
        </provider>
    </application>
</manifest>
