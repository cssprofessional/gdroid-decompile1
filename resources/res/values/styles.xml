<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Accent" parent="">
    </style>
    <style name="Accent.HalfLife" parent="@style/Accent">
        <item name="android:colorAccent">#f58220</item>
    </style>
    <style name="Accent.Portal" parent="@style/Accent">
        <item name="android:colorAccent">#61d9f5</item>
    </style>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0b0e10</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/AppTheme.Dialog</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorControlNormal">#5b666f</item>
        <item name="android:colorControlHighlight">#1fffffff</item>
        <item name="android:colorAccent">#61d9f5</item>
        <item name="android:statusBarColor">#0b0e10</item>
        <item name="android:navigationBarColor">#0b0e10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackgroundFloating">#1b2227</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="AppTheme.Dialog" parent="@android:style/ThemeOverlay.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_frame</item>
        <item name="android:windowTitleStyle">@style/DialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
    </style>
    <style name="DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textStyle">0x1</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <style name="DialogTitle" parent="">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">0x1</item>
        <item name="android:textColor">#e6eaed</item>
        <item name="android:ellipsize">3</item>
        <item name="android:maxLines">2</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="GameTheme" parent="@style/AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">2</item>
    </style>
    <style name="TextAppearance.Compat.Notification" parent="@android:style/TextAppearance.Material.Notification">
    </style>
    <style name="TextAppearance.Compat.Notification.Info" parent="@android:style/TextAppearance.Material.Notification.Info">
    </style>
    <style name="TextAppearance.Compat.Notification.Line2" parent="@style/TextAppearance.Compat.Notification.Info">
    </style>
    <style name="TextAppearance.Compat.Notification.Time" parent="@android:style/TextAppearance.Material.Notification.Time">
    </style>
    <style name="TextAppearance.Compat.Notification.Title" parent="@android:style/TextAppearance.Material.Notification.Title">
    </style>
    <style name="Widget.Compat.NotificationActionContainer" parent="">
        <item name="android:background">@drawable/notification_action_background</item>
    </style>
    <style name="Widget.Compat.NotificationActionText" parent="">
        <item name="android:textAppearance">?android:attr/textAppearanceButton</item>
        <item name="android:textSize">@dimen/notification_action_text_size</item>
        <item name="android:textColor">@color/secondary_text_default_material_light</item>
    </style>
</resources>
